{
    "name": "latipm-cli",
    "version": "0.2.6",
    "description": "Latino Package Manager - CLI para gestionar paquetes en latino",
    "type": "module",
    "main": "src/cli.ts",
    "bin": {
        "lpm": "src/cli.ts",
        "latipm": "src/cli.ts",
        "latinopm": "src/cli.ts"
    },
    "files": [
        "src"
    ],
    "scripts": {
        "dev": "bun run src/cli.ts",
        "link": "bun link",
        "install:global": "bun link",
        "install:win": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
        "install:unix": "bash scripts/install.sh"
    },
    "keywords": [
        "latino",
        "package-manager",
        "cli",
        "spanish",
        "latam"
    ],
    "author": "MDCDEV",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LatinoPackageManager/cli.git"
    },
    "dependencies": {
        "adm-zip": "^0.5.12",
        "ignore": "^7.0.5",
        "semver": "^7.6.3"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/node": "^25.8.0",
        "@types/semver": "^7.7.1",
        "bun-types": "^1.3.14",
        "typescript": "^5.4.5"
    }
}
